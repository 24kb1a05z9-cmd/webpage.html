            <a href="#skills">Skills</a>
            <a href="#contact">Contact</a>
        </div>
    </nav>

    <!-- Home Section -->
    <section class="home" id="home">
        <div class="home-content">

            <h1>Hi, I'm Marreddy Rishithanjali</h1>

            <h2>B.Tech Computer Science Engineering Student</h2>

            <p>
                Welcome to my personal webpage!
                I am a B.Tech student specializing in
                Computer Science and Engineering.
                I am interested in programming, web development,
                and learning new technologies.
            </p>

            <a href="#about" class="btn">Know More</a>

        </div>
    </section>

    <!-- About Section -->
    <section class="about" id="about">

        <h2>About Me</h2>

        <p>
            My name is <strong>Marreddy Rishithanjali</strong>.
            I am currently pursuing my B.Tech in
            Computer Science and Engineering (CSE).
            I enjoy learning programming languages,
            developing websites, and exploring new technologies.
            My goal is to improve my technical skills and
            build useful and creative projects.
        </p>

    </section>

    <!-- Skills Section -->
    <section class="skills" id="skills">

        <h2>My Skills</h2>

        <div class="skill-container">

            <div class="skill">HTML</div>
            <div class="skill">CSS</div>
            <div class="skill">JavaScript</div>
            <div class="skill">Python</div>
            <div class="skill">C Programming</div>
            <div class="skill">React</div>

        </div>

    </section>

    <!-- Contact Section -->
    <section class="contact" id="contact">

        <h2>Contact Me</h2>

        <p>Email: your-email@example.com</p>

        <p>GitHub: github.com/yourusername</p>

        <p>LinkedIn: linkedin.com/in/yourusername</p>

    </section>

    <!-- Footer -->
    <footer>
        <p>© 2026 Marreddy Rishithanjali. All Rights Reserved.</p>
    </footer>

</body>
</html>
