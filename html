 <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Marreddy Rishithanjali | CSE Student</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f4f7fb;
            color: #222;
        }

        /* Navigation Bar */
        nav {
            background: #1e3a8a;
            padding: 18px 50px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        nav h2 {
            color: white;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin-left: 25px;
            font-size: 16px;
        }

        nav a:hover {
            color: #93c5fd;
        }

        /* Home Section */
        .home {
            min-height: 85vh;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 40px;
        }

        .home-content {
            max-width: 700px;
        }

        .home h1 {
            font-size: 45px;
            color: #1e3a8a;
            margin-bottom: 15px;
        }

        .home h2 {
            font-size: 25px;
            margin-bottom: 15px;
        }

        .home p {
            font-size: 18px;
            color: #555;
            line-height: 1.6;
        }

        .btn {
            display: inline-block;
            margin-top: 25px;
            padding: 12px 25px;
            background: #1e3a8a;
            color: white;
            text-decoration: none;
            border-radius: 6px;
        }

        .btn:hover {
            background: #2563eb;
        }

        /* About Section */
        .about {
            background: white;
            padding: 60px 20px;
            text-align: center;
        }

        .about h2 {
            color: #1e3a8a;
            margin-bottom: 20px;
            font-size: 30px;
        }

        .about p {
            max-width: 700px;
            margin: auto;
            line-height: 1.7;
            color: #555;
        }

        /* Skills Section */
        .skills {
            padding: 60px 20px;
            text-align: center;
        }

        .skills h2 {
            color: #1e3a8a;
            margin-bottom: 30px;
            font-size: 30px;
        }

        .skill-container {
            display: flex;
            justify-content: center;
            gap: 20px;
            flex-wrap: wrap;
        }

        .skill {
            background: white;
            padding: 20px 35px;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            font-weight: bold;
        }

        /* Contact Section */
        .contact {
            background: #1e3a8a;
            color: white;
            text-align: center;
            padding: 50px 20px;
        }

        .contact h2 {
            margin-bottom: 15px;
        }

        .contact p {
            margin: 8px;
        }

        /* Footer */
        footer {
            background: #111827;
            color: white;
            text-align: center;
            padding: 15px;
        }

        /* Mobile Responsive */
        @media (max-width: 600px) {
            nav {
                padding: 15px 20px;
                flex-direction: column;
                gap: 10px;
            }

            nav a {
                margin-left: 10px;
            }

            .home h1 {
                font-size: 32px;
            }

            .home h2 {
                font-size: 20px;
            }
        }
    </style>
</head>

<body>

    <!-- Navigation -->
    <nav>
        <h2>Rishithanjali</h2>

        <div>
            <a href="#home">Home</a>
